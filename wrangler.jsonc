{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Menyajikan hasil `next build` (output: 'export') dari out/. worker/index.ts berjalan lebih dulu
  // untuk mengalihkan HTTP → HTTPS dan menambah header HSTS.
  "name": "hubbit-city-landing",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Cloudflare membuat record DNS + sertifikat untuk custom domain ini otomatis.
  "routes": [
    { "pattern": "hubbit.city", "custom_domain": true },
    { "pattern": "www.hubbit.city", "custom_domain": true }
  ],
  "workers_dev": false
}
